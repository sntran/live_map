<svg
  id={@id}
  class={if(@fullscreen?, do: [@class, "live-map-fullscreen"], else: @class)}
  data-live-map-zoom={@zoom}
  data-live-map-fullscreen={if(@fullscreen?, do: "true", else: "false")}
  version="1.1"
  xmlns="http://www.w3.org/2000/svg"
  width={if(@fullscreen?, do: "100%", else: @width)}
  height={if(@fullscreen?, do: "100%", else: @height)}
  viewBox={"0 0 #{@width} #{@height}"}
  preserveAspectRatio="none"
  style={
    if(@fullscreen?,
      do:
        "position: fixed; inset: 0; z-index: 2147483647; width: 100vw; height: 100vh; background: white;"
    )
  }
>
  <title>{@title}</title>

  <style>
    .live-map-control-surface {
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.24));
    }

    .live-map-control:hover .live-map-control-surface {
      fill: #f8f9fa;
    }

    .live-map-control:focus .live-map-control-surface {
      stroke: #1a73e8;
      stroke-width: 2;
    }

    <%= render_slot(@style) %>
  </style>

  <svg
    :if={@background_tiles != []}
    id={"#{@id}-background-tiles"}
    x="0"
    y="0"
    width={@width}
    height={@height}
    viewBox={"0 0 #{@width} #{@height}"}
    preserveAspectRatio="xMidYMid slice"
    opacity={@background_opacity}
    data-live-map-background-tiles="true"
  >
    <title>Background Tile Layer</title>

    <image
      :for={tile <- @background_tiles}
      :if={is_nil(tile[:view_box])}
      href={tile.href}
      x={tile.x - @min_x}
      y={tile.y - @min_y}
      width={tile.width}
      height={tile.height}
    />

    <svg
      :for={tile <- @background_tiles}
      :if={not is_nil(tile[:view_box])}
      x={tile.x - @min_x}
      y={tile.y - @min_y}
      width={tile.width}
      height={tile.height}
      viewBox={tile.view_box}
      preserveAspectRatio="none"
      overflow="hidden"
    >
      <image href={tile.href} x="0" y="0" width="256" height="256" />
    </svg>
  </svg>

  <svg
    id={"#{@id}-tiles"}
    x="0"
    y="0"
    width={@width}
    height={@height}
    viewBox={"0 0 #{@width} #{@height}"}
    preserveAspectRatio="xMidYMid slice"
  >
    <title>Tile Layer</title>

    <defs :if={@tile_layer.defs != []}>
      <%= for definition <- @tile_layer.defs do %>
        <%= definition %>
      <% end %>
    </defs>

    <image
      :for={tile <- @tile_layer.tiles}
      :if={tile.type == :image and is_nil(tile[:view_box])}
      href={tile.href}
      x={tile.x - @min_x}
      y={tile.y - @min_y}
      width={tile.width}
      height={tile.height}
    />

    <svg
      :for={tile <- @tile_layer.tiles}
      :if={tile.type == :image and not is_nil(tile[:view_box])}
      x={tile.x - @min_x}
      y={tile.y - @min_y}
      width={tile.width}
      height={tile.height}
      viewBox={tile.view_box}
      preserveAspectRatio="none"
      overflow="hidden"
    >
      <image href={tile.href} x="0" y="0" width="256" height="256" />
    </svg>

    <svg
      :for={tile <- @tile_layer.tiles}
      :if={tile.type == :svg_use}
      id={"#{@id}-tile-#{String.replace(tile.display_tile, "/", "-")}"}
      x={tile.x - @min_x}
      y={tile.y - @min_y}
      width={tile.width}
      height={tile.height}
      viewBox={tile.view_box}
      preserveAspectRatio="none"
      overflow="hidden"
      data-live-map-tile-state={tile.state}
      data-live-map-display-tile={tile.display_tile}
      data-live-map-source-tile={tile.source_tile}
      data-live-map-tile-placeholder={tile[:placeholder] && "parent"}
      data-live-map-fallback-tile={tile[:fallback_tile]}
    >
      <%= if tile.state == "loading" and tile[:placeholder] != true do %>
        <circle cx="128" cy="128" r="16" stroke="#9ca3af" stroke-width="4" fill="none" stroke-dasharray="25 75" stroke-linecap="round">
          <animateTransform attributeName="transform" type="rotate" from="0 128 128" to="360 128 128" dur="1s" repeatCount="indefinite" />
        </circle>
      <% else %>
        <use href={"##{tile.def_id}"} x="0" y="0" width="1" height="1" />
      <% end %>
    </svg>

    <svg
      :for={tile <- @tile_layer.tiles}
      :if={tile.type == :error}
      id={"#{@id}-tile-#{String.replace(tile.display_tile, "/", "-")}"}
      x={tile.x - @min_x}
      y={tile.y - @min_y}
      width={tile.width}
      height={tile.height}
      viewBox="0 0 1 1"
      preserveAspectRatio="none"
      overflow="hidden"
      data-live-map-tile-state={tile.state}
      data-live-map-display-tile={tile.display_tile}
      data-live-map-source-tile={tile.source_tile}
      data-live-map-tile-error-kind={tile.error_kind}
      data-live-map-tile-error-reason={tile.error_reason}
    />
  </svg>

  <svg
    id={"#{@id}-shapes"}
    x="0"
    y="0"
    width={@width}
    height={@height}
    viewBox={"0 0 #{@width} #{@height}"}
    preserveAspectRatio="xMidYMid slice"
    overflow="visible"
    class="live-map-shapes"
    data-live-map-shapes="true"
    :if={@shape_overlays != []}
  >
    <title>Shape Layer</title>

    <%= for shape <- @shape_overlays do %>
      <%= if shape.type == :polygon do %>
        <polygon
          id={shape.dom_id}
          class={["live-map-polygon", shape.class]}
          style={shape.style}
          data-live-map-shape="true"
          data-live-map-shape-type="polygon"
          data-live-map-shape-id={shape.id}
          points={shape.points_attribute}
          fill={shape.fill || "rgba(2,132,199,0.18)"}
          stroke={shape.stroke || "#0284c7"}
          stroke-width={shape.stroke_width || "2"}
        >
          <title :if={shape.label}>{shape.label}</title>
        </polygon>
      <% else %>
        <polyline
          id={shape.dom_id}
          class={["live-map-polyline", shape.class]}
          style={shape.style}
          data-live-map-shape="true"
          data-live-map-shape-type="polyline"
          data-live-map-shape-id={shape.id}
          points={shape.points_attribute}
          fill={shape.fill || "none"}
          stroke={shape.stroke || "#0284c7"}
          stroke-width={shape.stroke_width || "2"}
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <title :if={shape.label}>{shape.label}</title>
        </polyline>
      <% end %>
    <% end %>
  </svg>

  <svg
    id={"#{@id}-markers"}
    x="0"
    y="0"
    width={@width}
    height={@height}
    viewBox={"0 0 #{@width} #{@height}"}
    preserveAspectRatio="xMidYMid slice"
    overflow="visible"
    class="live-map-markers"
    data-live-map-markers="true"
  >
    <title>Marker Layer</title>

    <g :for={marker <- @marker_overlays}
      id={marker.dom_id}
      class="live-map-marker"
      data-live-map-marker="true"
      data-live-map-marker-id={marker.id}
      data-live-map-marker-title={marker.title}
      data-live-map-marker-label={marker.title}
      style={"transform: translate(#{marker.x}px, #{marker.y}px) scale(#{marker.scale});"}
    >
      <title>{marker.title}</title>

      <% marker_body = if marker.slot.inner_block, do: render_slot(marker.slot), else: nil %>

      <%= if slot_content_present?(marker_body) do %>
        <foreignObject
          x="-160"
          y="-160"
          width="320"
          height="320"
          overflow="visible"
          style="pointer-events: none;"
        >
          <div
            xmlns="http://www.w3.org/1999/xhtml"
            class="live-map-marker-html"
            style="pointer-events: none; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;"
          >
            <div class="live-map-marker-html-content" style="pointer-events: auto;">
              {marker_body}
            </div>
          </div>
        </foreignObject>
      <% else %>
        <path
          class="live-map-marker-pin"
          d="M0 -28C-5.523 -28 -10 -23.523 -10 -18c0 7.5 10 18 10 18s10 -10.5 10 -18c0 -5.523 -4.477 -10 -10 -10Z"
          fill="#DB4437"
          stroke="white"
          stroke-width="1.75"
          stroke-linejoin="round"
        />
        <circle class="live-map-marker-pin-center" cx="0" cy="-18" r="4.5" fill="#A52714" />
      <% end %>
    </g>
  </svg>

  <foreignObject
    :if={@attribution}
    x="8"
    y={@height - 24}
    width={max(@width - 16, 0)}
    height="18"
    overflow="visible"
    style="pointer-events: none;"
    class="live-map-attribution"
  >
    <div
      xmlns="http://www.w3.org/1999/xhtml"
      style="display: flex; align-items: flex-end; width: 100%; height: 100%; font: 10px/14px system-ui, sans-serif; color: #3c4043; pointer-events: none;"
    >
      <a
        :if={@attribution_url}
        href={@attribution_url}
        target="_blank"
        rel="noopener noreferrer"
        style="display: inline-block; padding: 1px 4px; color: inherit; background: rgb(255 255 255 / 0.82); text-decoration: none; pointer-events: auto;"
      >
        {@attribution}
      </a>
      <span
        :if={is_nil(@attribution_url)}
        style="display: inline-block; padding: 1px 4px; background: rgb(255 255 255 / 0.82); pointer-events: auto;"
      >
        {@attribution}
      </span>
    </div>
  </foreignObject>

  <g
    :if={@map_controls != []}
    class="live-map-controls"
    data-live-map-controls="true"
    data-live-map-controls-expanded={if(@map_controls_expanded?, do: "true", else: "false")}
    transform={"translate(#{@width - @map_control_width - 16},#{@height - @map_control_height - 16})"}
  >
    <g
      :for={control <- @map_controls}
      :if={not @map_controls_collapsible? or @map_controls_expanded?}
      class="live-map-control"
      data-live-map-control={control.action}
      data-live-map-control-step={control.step}
      role="button"
      tabindex="0"
      aria-label={control.label}
      width="36"
      height="36"
      transform={"translate(#{control.x},#{control.y})"}
      cursor="pointer"
      pointer-events="all"
      phx-click="map_control"
      phx-keyup="map_control"
      phx-value-action={control.action}
      phx-throttle="500"
      phx-target={@myself}
    >
      <circle class="live-map-control-surface" cx="18" cy="18" r="18" fill="white" />

      <foreignObject x="0" y="0" width="36" height="36" overflow="visible" pointer-events="none">
        <div
          xmlns="http://www.w3.org/1999/xhtml"
          style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; pointer-events: none;"
        >
          {render_slot(control.slot)}
        </div>
      </foreignObject>

      <circle cx="18" cy="18" r="18" fill="transparent" />
    </g>

    <g
      :if={@map_controls_collapsible?}
      class="live-map-control live-map-control-toggle"
      data-live-map-control-toggle="true"
      role="button"
      tabindex="0"
      aria-label={if(@map_controls_expanded?, do: "Collapse Map Controls", else: "Expand Map Controls")}
      aria-expanded={to_string(@map_controls_expanded?)}
      width="36"
      height="36"
      transform={
        "translate(#{@map_control_toggle_position.x},#{@map_control_toggle_position.y})"
      }
      cursor="pointer"
      pointer-events="all"
      phx-click="toggle_map_controls"
      phx-keyup="toggle_map_controls"
      phx-throttle="500"
      phx-target={@myself}
    >
      <circle class="live-map-control-surface" cx="18" cy="18" r="18" fill="white" />
      <path
        d="M18 7v22M14 11l4-4 4 4M14 25l4 4 4-4M7 18h22M11 14l-4 4 4 4M25 14l4 4-4 4"
        fill="none"
        stroke="#5f6368"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        pointer-events="none"
      />
      <circle cx="18" cy="18" r="18" fill="transparent" />
    </g>
  </g>

  <g
    :if={@fullscreen_control}
    class="live-map-control live-map-fullscreen-control"
    data-live-map-control="fullscreen"
    role="button"
    tabindex="0"
    aria-label={if(@fullscreen?, do: "Exit Fullscreen", else: "Enter Fullscreen")}
    width="36"
    height="36"
    transform={"translate(#{@width - 52},16)"}
    cursor="pointer"
    pointer-events="all"
    phx-click="map_control"
    phx-keyup="map_control"
    phx-value-action="fullscreen"
    phx-throttle="500"
    phx-target={@myself}
  >
    <circle class="live-map-control-surface" cx="18" cy="18" r="18" fill="white" />

    <foreignObject x="0" y="0" width="36" height="36" overflow="visible" pointer-events="none">
      <div
        xmlns="http://www.w3.org/1999/xhtml"
        style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; pointer-events: none;"
      >
        {render_slot(@fullscreen_control.slot)}
      </div>
    </foreignObject>

    <circle cx="18" cy="18" r="18" fill="transparent" />
  </g>
</svg>
